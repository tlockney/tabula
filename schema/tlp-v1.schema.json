{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabula.lockney.net/schema/tlp-v1.schema.json",
  "title": "Tabula Link Protocol v1 frames",
  "description": "Canonical JSON Schema for every TLP v1 frame. docs/PROTOCOL.md explains them; x-tabula-frames lists the frame types.",
  "x-tabula-protocol-version": 1,
  "x-tabula-frames": [
    "register",
    "subscribe",
    "state_delta",
    "command_result",
    "event",
    "log",
    "register_result",
    "ack",
    "error_result",
    "command_set_settings",
    "command_screen",
    "command_notify",
    "command_play_media",
    "command_media_control",
    "command_screensaver",
    "command_navigate",
    "command_reload",
    "command_restart_app",
    "command_clear_cache",
    "command_log_subscription",
    "command_screenshot",
    "http_pair_request",
    "http_pair_response",
    "http_claim_request",
    "http_claim_pending",
    "http_claim_response",
    "http_error",
    "http_screenshot_response"
  ],
  "$defs": {
    "device_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Random UUIDv4 generated by the device on first launch (lowercase)."
    },
    "command_id": {
      "type": "string",
      "pattern": "^[0-9A-Za-z_-]{8,64}$",
      "description": "Opaque ID chosen by the integration; unique per device connection."
    },
    "capability": {
      "enum": [
        "screen",
        "brightness",
        "adaptive_brightness",
        "screensaver",
        "notifications",
        "audio",
        "battery",
        "navigation",
        "logs",
        "screenshot"
      ]
    },
    "error_code": {
      "enum": [
        "invalid_frame",
        "unsupported_protocol",
        "unknown_device",
        "not_registered",
        "unsupported_command",
        "invalid_args",
        "stale_revision",
        "busy",
        "failed"
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/error_code"
        },
        "message": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "screen_on": {
          "type": "boolean"
        },
        "brightness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "adaptive_brightness": {
          "type": "boolean"
        },
        "keep_screen_on": {
          "type": "boolean"
        },
        "screensaver_active": {
          "type": "boolean"
        },
        "screensaver_mode": {
          "enum": [
            "clock",
            "black"
          ]
        },
        "screensaver_brightness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "next_screensaver": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "battery_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "charging": {
          "type": "boolean"
        },
        "network": {
          "enum": [
            "wifi",
            "ethernet",
            "none"
          ]
        },
        "wifi_rssi": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -127,
          "maximum": 0
        },
        "current_page": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "volume": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "muted": {
          "type": "boolean"
        },
        "media_state": {
          "enum": [
            "idle",
            "playing",
            "paused"
          ]
        },
        "app_version": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Device state. Every key is optional; a frame carries only keys that changed."
    },
    "log_line": {
      "type": "object",
      "properties": {
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "level": {
          "enum": [
            "debug",
            "info",
            "warning",
            "error"
          ]
        },
        "tag": {
          "type": "string",
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "ts",
        "level",
        "tag",
        "message"
      ],
      "additionalProperties": false
    },
    "register": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "tabula/register"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "protocol_version": {
          "type": "integer",
          "minimum": 1
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "app_version": {
          "type": "string",
          "maxLength": 64
        },
        "manufacturer": {
          "type": "string",
          "maxLength": 64
        },
        "model": {
          "type": "string",
          "maxLength": 64
        },
        "os_version": {
          "type": "string",
          "maxLength": 64
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          },
          "uniqueItems": true
        },
        "settings_revision": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/state"
        }
      },
      "required": [
        "id",
        "type",
        "device_id",
        "protocol_version",
        "schema_version",
        "app_version",
        "manufacturer",
        "model",
        "os_version",
        "capabilities",
        "settings_revision",
        "state"
      ],
      "additionalProperties": false
    },
    "subscribe": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "tabula/subscribe"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false
    },
    "state_delta": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "tabula/state"
        },
        "state": {
          "$ref": "#/$defs/state"
        }
      },
      "required": [
        "id",
        "type",
        "state"
      ],
      "additionalProperties": false
    },
    "command_result": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "tabula/result"
        },
        "command_id": {
          "$ref": "#/$defs/command_id"
        },
        "ok": {
          "type": "boolean"
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "type",
        "command_id",
        "ok"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "ok": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      },
      "else": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "tabula/event"
        },
        "event": {
          "enum": [
            "notification_shown",
            "notification_dismissed",
            "notification_action",
            "screensaver_started",
            "screensaver_stopped",
            "media_finished",
            "page_changed"
          ]
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "type",
        "event",
        "data"
      ],
      "additionalProperties": false
    },
    "log": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "tabula/log"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/log_line"
          },
          "minItems": 1,
          "maxItems": 200
        }
      },
      "required": [
        "id",
        "type",
        "lines"
      ],
      "additionalProperties": false
    },
    "register_result": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "result"
        },
        "success": {
          "const": true
        },
        "result": {
          "type": "object",
          "properties": {
            "ha_device_id": {
              "type": "string",
              "minLength": 1
            },
            "protocol_version": {
              "type": "integer",
              "minimum": 1
            },
            "settings_revision": {
              "type": "integer",
              "minimum": 0
            },
            "server_time": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "ha_device_id",
            "protocol_version",
            "settings_revision",
            "server_time"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "success",
        "result"
      ],
      "additionalProperties": false
    },
    "ack": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "result"
        },
        "success": {
          "const": true
        },
        "result": {
          "type": "null"
        }
      },
      "required": [
        "id",
        "type",
        "success",
        "result"
      ],
      "additionalProperties": false,
      "description": "Result for subscribe, state, result, event and log."
    },
    "error_result": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "result"
        },
        "success": {
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "translation_key": {
              "type": "string"
            },
            "translation_domain": {
              "type": "string"
            },
            "translation_placeholders": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "success",
        "error"
      ],
      "additionalProperties": false,
      "description": "HA error envelope. Tabula errors use error_code values; HA may also send its own codes."
    },
    "command_set_settings": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "event"
        },
        "event": {
          "type": "object",
          "properties": {
            "command_id": {
              "$ref": "#/$defs/command_id"
            },
            "command": {
              "const": "set_settings"
            },
            "args": {
              "type": "object",
              "properties": {
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "schema_version": {
                  "type": "integer",
                  "minimum": 1
                },
                "settings": {
                  "type": "object"
                }
              },
              "required": [
                "revision",
                "schema_version",
                "settings"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "command_id",
            "command",
            "args"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "event"
      ],
      "additionalProperties": false,
      "description": "Replace the device's settings. Validated against settings.schema.json (P0.5)."
    },
    "command_screen": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "event"
        },
        "event": {
          "type": "object",
          "properties": {
            "command_id": {
              "$ref": "#/$defs/command_id"
            },
            "command": {
              "const": "screen"
            },
            "args": {
              "type": "object",
              "properties": {
                "on": {
                  "type": "boolean"
                },
                "brightness": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [],
              "additionalProperties": false,
              "minProperties": 1
            }
          },
          "required": [
            "command_id",
            "command",
            "args"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "event"
      ],
      "additionalProperties": false,
      "description": "Panel on/off and manual brightness."
    },
    "command_notify": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "event"
        },
        "event": {
          "type": "object",
          "properties": {
            "command_id": {
              "$ref": "#/$defs/command_id"
            },
            "command": {
              "const": "notify"
            },
            "args": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "title": {
                  "type": "string",
                  "maxLength": 200
                },
                "level": {
                  "enum": [
                    "info",
                    "success",
                    "warning",
                    "alert"
                  ]
                },
                "duration": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3600,
                  "description": "Seconds; 0 keeps it until dismissed. Omitted uses the device setting."
                },
                "icon": {
                  "type": "string",
                  "pattern": "^mdi:[a-z0-9-]+$"
                },
                "chime": {
                  "type": "boolean"
                },
                "tag": {
                  "type": "string",
                  "maxLength": 64,
                  "description": "A new notification with the same tag replaces the old one."
                }
              },
              "required": [
                "message"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "command_id",
            "command",
            "args"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "event"
      ],
      "additionalProperties": false,
      "description": "Show an on-screen notification."
    },
    "command_play_media": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "event"
        },
        "event": {
          "type": "object",
          "properties": {
            "command_id": {
              "$ref": "#/$defs/command_id"
            },
            "command": {
              "const": "play_media"
            },
            "args": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://",
                  "maxLength": 4096
                },
                "media_type": {
                  "enum": [
                    "music",
                    "audio"
                  ]
                },
                "announce": {
                  "type": "boolean"
                },
                "volume": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "url",
                "media_type",
                "announce"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "command_id",
            "command",
            "args"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "event"
      ],
      "additionalProperties": false,
      "description": "Play an audio URL, e.g. a tts_proxy URL."
    },
    "command_media_control": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "event"
        },
        "event": {
          "type": "object",
          "properties": {
            "command_id": {
              "$ref": "#/$defs/command_id"
            },
            "command": {
              "const": "media_control"
            },
            "args": {
              "type": "object",
              "properties": {
                "action": {
                  "enum": [
                    "stop",
                    "pause",
                    "resume",
                    "set_volume",
                    "mute",
                    "unmute"
                  ]
                },
                "volume": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "action"
              ],
              "additionalProperties": false,
              "if": {
                "properties": {
                  "action": {
                    "const": "set_volume"
                  }
                }
              },
              "then": {
                "required": [
                  "volume"
                ]
              }
            }
          },
          "required": [
            "command_id",
            "command",
            "args"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "event"
      ],
      "additionalProperties": false,
      "description": "Control audio playback and volume."
    },
    "command_screensaver": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "event"
        },
        "event": {
          "type": "object",
          "properties": {
            "command_id": {
              "$ref": "#/$defs/command_id"
            },
            "command": {
              "const": "screensaver"
            },
            "args": {
              "type": "object",
              "properties": {
                "active": {
                  "type": "boolean"
                },
                "mode": {
                  "enum": [
                    "clock",
                    "black"
                  ]
                }
              },
              "required": [
                "active"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "command_id",
            "command",
            "args"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "event"
      ],
      "additionalProperties": false,
      "description": "Start or stop the screensaver."
    },
    "command_navigate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "event"
        },
        "event": {
          "type": "object",
          "properties": {
            "command_id": {
              "$ref": "#/$defs/command_id"
            },
            "command": {
              "const": "navigate"
            },
            "args": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/",
                  "maxLength": 2048
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "command_id",
            "command",
            "args"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "event"
      ],
      "additionalProperties": false,
      "description": "Load an HA frontend path in the dashboard WebView."
    },
    "command_reload": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "event"
        },
        "event": {
          "type": "object",
          "properties": {
            "command_id": {
              "$ref": "#/$defs/command_id"
            },
            "command": {
              "const": "reload"
            },
            "args": {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "command_id",
            "command",
            "args"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "event"
      ],
      "additionalProperties": false,
      "description": "Reload the dashboard WebView."
    },
    "command_restart_app": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "event"
        },
        "event": {
          "type": "object",
          "properties": {
            "command_id": {
              "$ref": "#/$defs/command_id"
            },
            "command": {
              "const": "restart_app"
            },
            "args": {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "command_id",
            "command",
            "args"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "event"
      ],
      "additionalProperties": false,
      "description": "Restart the app process."
    },
    "command_clear_cache": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "event"
        },
        "event": {
          "type": "object",
          "properties": {
            "command_id": {
              "$ref": "#/$defs/command_id"
            },
            "command": {
              "const": "clear_cache"
            },
            "args": {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "command_id",
            "command",
            "args"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "event"
      ],
      "additionalProperties": false,
      "description": "Clear WebView cache and reload."
    },
    "command_log_subscription": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "event"
        },
        "event": {
          "type": "object",
          "properties": {
            "command_id": {
              "$ref": "#/$defs/command_id"
            },
            "command": {
              "const": "log_subscription"
            },
            "args": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "level": {
                  "enum": [
                    "debug",
                    "info",
                    "warning",
                    "error"
                  ]
                }
              },
              "required": [
                "enabled"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "command_id",
            "command",
            "args"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "event"
      ],
      "additionalProperties": false,
      "description": "Start or stop streaming log lines as tabula/log frames."
    },
    "command_screenshot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "event"
        },
        "event": {
          "type": "object",
          "properties": {
            "command_id": {
              "$ref": "#/$defs/command_id"
            },
            "command": {
              "const": "screenshot"
            },
            "args": {
              "type": "object",
              "properties": {
                "quality": {
                  "type": "integer",
                  "minimum": 10,
                  "maximum": 95
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "command_id",
            "command",
            "args"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "event"
      ],
      "additionalProperties": false,
      "description": "Capture the screen and upload it over HTTP (capability: screenshot, Phase 3)."
    },
    "http_pair_request": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "code": {
          "type": "string",
          "pattern": "^[0-9]{6}$"
        },
        "nonce_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "model": {
          "type": "string",
          "maxLength": 64
        },
        "protocol_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "device_id",
        "code",
        "nonce_hash",
        "protocol_version"
      ],
      "additionalProperties": false
    },
    "http_pair_response": {
      "type": "object",
      "properties": {
        "status": {
          "const": "pending"
        },
        "expires_in": {
          "type": "integer",
          "minimum": 1
        },
        "poll_interval": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "status",
        "expires_in",
        "poll_interval"
      ],
      "additionalProperties": false
    },
    "http_claim_request": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "device_id",
        "nonce"
      ],
      "additionalProperties": false
    },
    "http_claim_pending": {
      "type": "object",
      "properties": {
        "status": {
          "const": "pending"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "http_claim_response": {
      "type": "object",
      "properties": {
        "status": {
          "const": "paired"
        },
        "credential": {
          "type": "object",
          "properties": {
            "type": {
              "const": "refresh_token"
            },
            "refresh_token": {
              "type": "string",
              "minLength": 32
            },
            "token_url": {
              "const": "/auth/token"
            }
          },
          "required": [
            "type",
            "refresh_token",
            "token_url"
          ],
          "additionalProperties": false
        },
        "ha_device_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "credential",
        "ha_device_id"
      ],
      "additionalProperties": false
    },
    "http_error": {
      "type": "object",
      "properties": {
        "error": {
          "enum": [
            "invalid_request",
            "rate_limited",
            "too_many_pending",
            "expired",
            "bad_nonce",
            "unknown_device",
            "unsupported_protocol",
            "forbidden",
            "too_large"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "retry_after": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "http_screenshot_response": {
      "type": "object",
      "properties": {
        "status": {
          "const": "stored"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "status",
        "bytes"
      ],
      "additionalProperties": false
    }
  }
}
