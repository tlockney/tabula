  "services": {
    "notify": {
      "name": "Show notification",
      "description": "Shows a notification card on the targeted tablets.",
      "fields": {
        "message": {
          "name": "Message",
          "description": "Text of the card. Limited Markdown is rendered."
        },
        "title": {
          "name": "Title",
          "description": "Optional title above the message."
        },
        "level": {
          "name": "Level",
          "description": "Severity: sets the stock icon and accent color."
        },
        "duration": {
          "name": "Duration",
          "description": "Seconds before the card goes away; 0 keeps it until dismissed. Omit to use the tablet's setting."
        },
        "icon": {
          "name": "Icon",
          "description": "Material Design icon that replaces the level's icon."
        },
        "chime": {
          "name": "Chime",
          "description": "Play the notification sound."
