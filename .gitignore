# Build output
/build/
# Gradle keeps per-module build directories under android/ (docs/DEVELOPMENT.md)
android/**/build/

# Git worktrees (AGENTS.md, "Worktrees")
/.worktrees/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/

# The Tabularium bundle: `make panel` builds build/panel and stages it here
# because HA serves only files inside the integration's directory (P5.1)
integration/custom_components/tabula/panel/

# Android / Gradle (android/ arrives in P2.0)
.gradle/
local.properties
*.apk
*.aab
*.keystore
*.jks

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Local secrets and device credentials never belong in the repo
.env
.env.*
*.local
